APP_NAME=ButcherAPI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database (PostgreSQL — local & production Render) ───────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=butcher_db
DB_USERNAME=postgres
DB_PASSWORD=

# MySQL (legacy local uniquement) :
# DB_CONNECTION=mysql
# DB_PORT=3306
# DB_USERNAME=root

# ── Cache / Session ──────────────────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origines autorisées, séparées par virgule (ex: https://app.example.com)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://localhost,http://localhost,capacitor://localhost

# ── Sanctum ──────────────────────────────────────────────────────────────────
SANCTUM_STATELESS_DOMAINS=localhost,127.0.0.1
# Expiration des tokens en minutes (43200 = 30 jours). null = jamais.
SANCTUM_TOKEN_EXPIRATION=43200

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@butcherie.app"
MAIL_FROM_NAME="${APP_NAME}"
